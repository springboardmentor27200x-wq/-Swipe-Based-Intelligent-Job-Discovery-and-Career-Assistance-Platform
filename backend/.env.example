# Copy this file to .env and fill in real values for local development.
# In production (Render/Docker), set these as actual environment
# variables in the platform's dashboard instead of committing a .env file.

# Postgres connection string.
# Local:            postgresql://<user>:<password>@localhost:5432/jobmatch_ai
# Render Postgres:   provided automatically as DATABASE_URL when you attach a Render Postgres instance
# AWS RDS Postgres:  postgresql://<user>:<password>@<rds-endpoint>:5432/<db_name>
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# JWT signing key — generate a real random value for production,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=<generate-a-random-secret-for-production>

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of frontend origins allowed to call this API.
# Example once deployed: https://swipex.vercel.app,http://localhost:5500
ALLOWED_ORIGINS=*

PORT=8000

