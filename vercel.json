{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/upload", "destination": "/upload.html" },
    { "source": "/jobs-page/", "destination": "/jobs.html" },
    { "source": "/jobs-page", "destination": "/jobs.html" },
    { "source": "/companies", "destination": "/companies.html" },
    { "source": "/saved", "destination": "/saved.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/match", "destination": "/match.html" },
    { "source": "/recruiter", "destination": "/recruiter.html" },
    { "source": "/candidates", "destination": "/candidates.html" },
    { "source": "/applications", "destination": "/applications.html" },
    { "source": "/track", "destination": "/track.html" }
  ]
}