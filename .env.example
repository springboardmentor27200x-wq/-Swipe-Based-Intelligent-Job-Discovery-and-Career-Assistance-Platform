# ─── SwipeX Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values

# ─── Backend Configuration ────────────────────────────────────────────────────
SECRET_KEY=swipex-super-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite - default, no setup needed)
DATABASE_URL=sqlite:///./swipex.db

# Production (PostgreSQL - use with Docker Compose)
# DATABASE_URL=postgresql://swipex_user:swipex_secure_password_2024@localhost:5432/swipex

# ─── OpenAI API (for real AI features) ───────────────────────────────────────
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Redis (optional, for caching) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
